<sdf version="1.6"><model name="overview"><static>true</static><pose>-4 -5 5 0 0.62 0.85</pose><link name="camera"><sensor name="overview" type="camera"><always_on>true</always_on><update_rate>2</update_rate><camera><horizontal_fov>1.3</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>.1</near><far>50</far></clip></camera><plugin name="overview_camera" filename="libgazebo_ros_camera.so"><camera_name>overview</camera_name><frame_name>overview</frame_name></plugin></sensor></link></model></sdf>
