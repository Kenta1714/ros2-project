<sdf version="1.6"><world name="patrol">
<physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  <scene><ambient>0.7 0.7 0.7 1</ambient><shadows>false</shadows></scene>
<light name="sun" type="directional"><direction>-.4 .2 -1</direction><diffuse>.9 .9 .9 1</diffuse></light>
<model name="floor"><static>true</static><pose>0 0 -.05 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>12 12 .1</size></box></geometry></collision><visual name="v"><geometry><box><size>12 12 .1</size></box></geometry><material><ambient>.6 .6 .6 1</ambient><diffuse>.6 .6 .6 1</diffuse></material></visual></link></model><model name="east"><static>true</static><pose>5 0 1 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>.1 10 2</size></box></geometry></collision><visual name="v"><geometry><box><size>.1 10 2</size></box></geometry><material><ambient>.65 .6 .45 1</ambient><diffuse>.65 .6 .45 1</diffuse></material></visual></link></model><model name="west"><static>true</static><pose>-5 0 1 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>.1 10 2</size></box></geometry></collision><visual name="v"><geometry><box><size>.1 10 2</size></box></geometry><material><ambient>.65 .6 .45 1</ambient><diffuse>.65 .6 .45 1</diffuse></material></visual></link></model><model name="north"><static>true</static><pose>0 5 1 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>10 .1 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 .1 2</size></box></geometry><material><ambient>.65 .6 .45 1</ambient><diffuse>.65 .6 .45 1</diffuse></material></visual></link></model><model name="south"><static>true</static><pose>0 -5 1 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>10 .1 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 .1 2</size></box></geometry><material><ambient>.65 .6 .45 1</ambient><diffuse>.65 .6 .45 1</diffuse></material></visual></link></model><model name="box1"><static>true</static><pose>1.8 0 .4 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>.6 1 .8</size></box></geometry></collision><visual name="v"><geometry><box><size>.6 1 .8</size></box></geometry><material><ambient>.65 .6 .45 1</ambient><diffuse>.65 .6 .45 1</diffuse></material></visual></link></model><model name="box2"><static>true</static><pose>-2 -2 .4 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>.8 .8 .8</size></box></geometry></collision><visual name="v"><geometry><box><size>.8 .8 .8</size></box></geometry><material><ambient>.65 .6 .45 1</ambient><diffuse>.65 .6 .45 1</diffuse></material></visual></link></model><actor name="person"><skin><filename>file://media/models/walk.dae</filename><scale>1</scale></skin><animation name="walking"><filename>file://media/models/walk.dae</filename><scale>1</scale><interpolate_x>false</interpolate_x></animation><script><loop>true</loop><auto_start>true</auto_start><trajectory id="0" type="walking"><waypoint><time>0</time><pose>1 -3 0 0 0 1.57</pose></waypoint><waypoint><time>100</time><pose>1 -3 0 0 0 1.57</pose></waypoint></trajectory></script></actor><model name="person_collision"><static>true</static><pose>1 -3 .9 0 0 0</pose><link name="body"><collision name="c"><geometry><box><size>.4 .4 1.8</size></box></geometry></collision></link></model></world></sdf>